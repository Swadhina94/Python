#Write a Python program to check whether a given number is a Sunny Number or not.
#A number is called a Sunny Number if the number + 1 is a perfect square.
s = float(input("Enter "))
n = int(s)
count = 0
i = 1

while i < n:
    a = n + 1
    if a == i**2:
        count += 1
    i += 1

if count == 1:
    print("sunny")
else:
    print("not")

